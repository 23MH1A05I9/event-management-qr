# Copy this file to .env and fill in your real local values.
# .env is gitignored — it will never be committed.
# In production (Railway), these are set as real environment variables in the dashboard instead.

DB_URL=jdbc:mysql://localhost:3306/eventdbqr?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_local_mysql_password

MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password

PORT=8080
